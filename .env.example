# Bad CRM — environment template (STORY-001-05).
#
# QUICK START
#   cp .env.example .env
#   openssl rand -base64 32          # -> APP_ENCRYPTION_KEY  (must be exactly 32 bytes, base64)
#   openssl rand -base64 48          # -> JWT_SECRET          (>= 32 characters)
#   pnpm docker:up && pnpm dev
#
# The two secrets above have no usable placeholder: `APP_ENCRYPTION_KEY` is checked for being
# 32 decoded bytes, so a `CHANGE_ME_…` string fails the startup check by design. That refusal is
# the feature — an installation must never run on a key that ships in a public repository
# (rules/self-host-packaging.mdc, rule 6; docs/security/threat-model.md, T-SH-01).
#
# HOW THIS FILE IS CHECKED
#   `test/env/env-example-sync.test.ts` compares the keys below against the Zod schemas
#   (`packages/server/src/infrastructure/bootstrap/env.schema.ts`,
#   `packages/client/src/shared/config/env.schema.ts`) and against every `${VAR}` referenced by
#   `docker-compose.yml`. A variable added to code but not here — or the other way round — fails
#   the build. Do not add a variable in one place only.
#
# REQUIRED / OPTIONAL
#   Every entry is marked. "required" means the server refuses to start without it; "optional"
#   means the feature it configures degrades and the rest of the application keeps working.
#
# DEVELOPMENT VS PRODUCTION
#   `CHANGE_ME_…` placeholders and the `dev_…` fallbacks of docker-compose.yml are a warning in
#   development and a hard startup failure in production. Never copy this file onto a server
#   unchanged.
#
# Real `.env` files are git-ignored; only this template is committed.


# ─────────────────────────────────────────────────────────────────────────────────────────────
# 1. Docker Compose — local development services
#    Consumed by docker-compose.yml, not by the application. Ports are published on 127.0.0.1
#    only; override them when a host port is already taken.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Which services `pnpm docker:up` starts (optional, default: default).
#   minimal — postgres + redis + minio            (no search, no mail catcher)
#   default — the above + meilisearch + mailpit
COMPOSE_PROFILES=default

# PostgreSQL superuser of the *local* cluster (optional, dev defaults apply).
POSTGRES_USER=bad_crm
POSTGRES_PASSWORD=CHANGE_ME_local_postgres_password
POSTGRES_DB=bad_crm
POSTGRES_PORT=5432

# Passwords of the four database roles created by prisma/sql/initdb on first start (and re-applied
# by `pnpm db:bootstrap` afterwards). `app_migrator` owns the schema, `app_user` runs the application
# under RLS, `app_auth` serves authentication, `backup_role` is the read-only BYPASSRLS role pg_dump
# must use — a dump taken as the table owner under FORCE ROW LEVEL SECURITY is silently partial
# (docs/security/rls-design.md, docs/runbooks/backup-restore.md). Dev defaults apply.
APP_MIGRATOR_PASSWORD=CHANGE_ME_local_migrator_password
APP_USER_PASSWORD=CHANGE_ME_local_app_user_password
APP_AUTH_PASSWORD=CHANGE_ME_local_app_auth_password
BACKUP_ROLE_PASSWORD=CHANGE_ME_local_backup_role_password

# Redis (optional, dev default applies).
REDIS_PORT=6379

# MinIO — S3-compatible storage for presigned uploads (optional, dev defaults apply).
MINIO_ROOT_USER=CHANGE_ME_local_minio_user
MINIO_ROOT_PASSWORD=CHANGE_ME_local_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Meilisearch — only started by the `default` profile (optional).
MEILI_PORT=7700

# Mailpit — SMTP catcher, only started by the `default` profile (optional).
MAILPIT_MAX_MESSAGES=5000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025


# ─────────────────────────────────────────────────────────────────────────────────────────────
# 2. Application — required
#    Missing or malformed values stop the process before the HTTP port opens.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# development | test | production (optional, default: development).
#
# Anything that is NOT `development` — `test` included — turns on the preflight: placeholder secrets
# (`CHANGE_ME`, `dev_`) and a non-loopback `http://` APP_URL are refused and the process does not
# start. The scope is "not development" rather than "production" on purpose: a deployment left in
# the `test` environment would otherwise boot on a placeholder secret, and the threat model
# (T-SH-01, T-SH-03) treats every non-development boot as internet-reachable.
NODE_ENV=development

# HTTP port of the API process (optional, default: 3000).
PORT=3000

# Public base URL of this installation: CORS allow-list, cookie scope and links inside emails.
# REQUIRED. Must be https in production (an http URL is refused unless it is loopback).
APP_URL=http://localhost:3000

# Application connection to PostgreSQL. REQUIRED.
# The role must NOT have BYPASSRLS: tenant isolation depends on the policies applying to it.
DATABASE_URL=postgres://app_user:CHANGE_ME_local_app_user_password@localhost:5432/bad_crm

# Owner-role connection, used by `prisma migrate deploy` and by `pnpm db:grants`. The application
# process never opens it, which is why it is not in the required list above — but MIGRATIONS DO NOT
# RUN WITHOUT IT. app_user has no CREATE on schema public (by design: the role that serves requests
# must not be able to create objects), so migrating over DATABASE_URL fails on the very first step,
# where Prisma creates its own `_prisma_migrations` table:
#   ERROR: permission denied for schema public
# Leave it set unless this installation genuinely never migrates its own database.
DATABASE_MIGRATION_URL=postgres://app_migrator:CHANGE_ME_local_migrator_password@localhost:5432/bad_crm

# Authentication connection to PostgreSQL — the `app_auth` role. OPTIONAL IN THE SCHEMA AND
# REQUIRED IN PRACTICE: without it NOBODY CAN SIGN IN. It is optional only so that upgrading an
# existing installation does not stop it from starting; leaving it unset is not a supported
# configuration. An installation without it says so in three places: a `warn` line at startup, the
# field `authentication: unavailable` in `GET /ready`, and a 503 with the code `service_unavailable`
# on the first sign-in (instead of an unexplained 500).
# The role holds no table privileges at all: its whole reachable surface is three
# SECURITY DEFINER functions that resolve an account before the organization is known and a session
# before the tenant is known (docs/security/rls-design.md, «Особые пути»). They run as a separate
# NOLOGIN owner, which is what keeps this credential from being able to read anything on its own.
# A separate pool, so the connection used for that path is not one an ordinary repository can pick up.
# The role this URL connects as is verified at startup: pointing it at app_migrator or a superuser
# would work perfectly and give the sign-in path write access to every organization, so the process
# refuses to open its port instead.
DATABASE_AUTH_URL=postgres://app_auth:CHANGE_ME_local_app_auth_password@localhost:5432/bad_crm

# Redis: BullMQ broker, socket.io backplane, rate-limit counters, session revocation. REQUIRED.
REDIS_URL=redis://localhost:6379

# Signing key of the 15-minute access token. REQUIRED, at least 32 characters.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Master key for AES-256-GCM encryption of integration secrets (AI keys, SMTP passwords, GitHub
# tokens, TOTP seeds). REQUIRED, exactly 32 bytes encoded as base64 — nothing else is accepted.
#   openssl rand -base64 32
# Losing this key makes every stored secret unrecoverable; back it up separately from the database.
APP_ENCRYPTION_KEY=CHANGE_ME_generate_with_openssl_rand_base64_32

# S3-compatible object storage. All four are REQUIRED.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bad-crm
S3_ACCESS_KEY=CHANGE_ME_local_minio_user
S3_SECRET_KEY=CHANGE_ME_local_minio_password
# Optional, defaults below. Path-style addressing is what MinIO needs; real AWS S3 does not.
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true


# ─────────────────────────────────────────────────────────────────────────────────────────────
# 3. Application — optional services
#    Absent → the feature degrades, the installation still starts. The startup log prints a
#    summary of everything running in reduced form (stack.md, «Деградация»).
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Meilisearch. Absent → search falls back to PostgreSQL full-text search (ADR-0011).
# MEILI_MASTER_KEY becomes required as soon as MEILI_HOST is set.
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=CHANGE_ME_local_meili_master_key
# development | production — mirrors Meilisearch's own setting (optional).
MEILI_ENV=development
# Hard ceiling on the memory Meilisearch uses while indexing (optional, default below).
# Its own default is two thirds of the host's RAM, which on a single-host install means the first
# full reindex takes the memory PostgreSQL is running on and the database is OOM-killed.
# Size it for the host — docs/runbooks/hosting.md, section on memory.
MEILI_MAX_INDEXING_MEMORY=512Mb

# Outgoing mail. Absent → mail operations answer 503 `mail_not_configured` and NOTHING is written:
# the password-reset letter carries a single-use token inside its link, and a log is the least
# private place in a deployment. For development use Mailpit, which the `default` compose profile
# starts — this URL points at it.
# Connection, greeting and socket timeouts are applied unless you set your own here as query
# parameters (`?socketTimeout=120000`): nodemailer's own defaults are 2 min / 30 s / 10 min, and a
# relay that accepts the connection and then goes quiet would hold a request thread for all of it.
SMTP_URL=smtp://localhost:1025

# The mailbox this installation sends from — the SMTP envelope sender, on every message.
# REQUIRED as soon as SMTP_URL is set, and ignored otherwise. Without it nodemailer sends an empty
# `MAIL FROM`: Mailpit accepts that, which is why development looks fine, while Postfix, SES and
# every relay that checks the envelope answer 5.x and the installation sends no mail at all.
# Use an address the relay is willing to send as; a display name is optional.
MAIL_FROM=Bad CRM <crm@localhost>

# Installation-wide AI switch (optional, default: false). Provider API keys are NOT configured
# here: an organization admin enters them in the UI and they are stored encrypted (ADR-0014).
AI_ENABLED=false

# OpenTelemetry collector. Absent → traces are not exported; logs and metrics keep working.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Extra browser origins allowed by CORS, comma-separated. APP_URL is always allowed (optional).
# CORS_EXTRA_ORIGINS=https://staging.example.com


# ─────────────────────────────────────────────────────────────────────────────────────────────
# 4. Application — tuning (all optional, defaults shown)
# ─────────────────────────────────────────────────────────────────────────────────────────────

# fatal | error | warn | info | debug | trace. No level logs request bodies or URLs: the URL of a
# protected link is itself the credential, and a body is user content (http-logger.middleware.ts).
LOG_LEVEL=info

# Run queue workers inside the API process. A deliberate exception for the `minimal` profile on a
# small host — not the default, because one slow job then blocks the HTTP event loop.
RUN_WORKERS_IN_PROCESS=false

# How many X-Forwarded-For hops in front of the app are YOUR OWN reverse proxies.
# OPTIONAL, default 0 — this compose file ships no reverse proxy, so by default there is nothing
# between a client and the app and the header is whatever the client typed. Set it to 1 when you put
# exactly one Caddy / nginx / Traefik in front (docs/runbooks/install.md §3), and to the number of
# hops if there are more. Getting it wrong in either direction has a cost: too low and everyone
# behind your proxy looks like one address to the rate limiter, too high and any client can choose
# the address recorded on its own sessions and mint itself a fresh rate-limit budget per request.
TRUSTED_PROXY_HOPS=0

# Whether this installation still accepts new organizations through the registration form.
# OPTIONAL, default true — the first door has to be open before anybody can close it. Set it to
# false once your organization exists: an open endpoint lets an anonymous visitor fill the database.
REGISTRATION_OPEN=true

# Argon2id parameters (OWASP baseline). Raise on a powerful host, lower on a Raspberry Pi.
# Existing password hashes keep working: the parameters are stored inside the hash string.
# The server refuses to start below the OWASP floor (m=19456, t=2, p=1).
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1


# ─────────────────────────────────────────────────────────────────────────────────────────────
# 5. Browser bundle
#    Vite inlines these into the JavaScript it ships, so anything here is public by definition.
#    A secret must never be given a VITE_ name — that is the whole meaning of the prefix.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Where the SPA calls the API. Relative by default: both are served from the same origin.
VITE_API_BASE_URL=/api/v1
