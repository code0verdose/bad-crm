# pnpm — строгий режим зависимостей
# Плоский node_modules отключён: пакет не может использовать то, что не объявил
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true

# Единая версия пакет-менеджера у всех участников
engine-strict=true

# Безопасность: не выполнять postinstall-скрипты без явного разрешения
# (список разрешённых ведётся в package.json → pnpm.onlyBuiltDependencies)
enable-pre-post-scripts=false
