{
  "name": "bad-crm",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted, multi-tenant workspace for software teams",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "tsx scripts/preflight.ts && turbo run dev --filter=!@bad-crm/landing",
    "dev:landing": "turbo run dev --filter=@bad-crm/landing",
    "check:services": "tsx scripts/check-services.ts",
    "check:rls": "pnpm --filter @bad-crm/server run check:rls",
    "coverage:baseline": "tsx scripts/ci/coverage-baseline.ts",
    "scan:cruft": "tsx scripts/ci/scan-cruft.ts",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:repo": "eslint . --ignore-pattern packages/ --max-warnings 0",
    "stylelint": "stylelint \"packages/*/src/**/*.css\" --max-warnings 0",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:repo": "tsc -p tsconfig.scripts.json && vitest run",
    "test:integration": "turbo run test:integration",
    "test:integration:local": "scripts/docker/testcontainers-env.sh turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "i18n:check": "pnpm --filter @bad-crm/client exec vitest run test/i18n --coverage.enabled=false && tsx scripts/ci/i18n-summary.ts",
    "db:bootstrap": "docker compose run --rm --no-deps -e PGHOST=postgres --entrypoint sh postgres /opt/bad-crm/sql/initdb/00-bootstrap-roles.sh",
    "db:grants": "docker compose exec -T postgres sh -c 'psql -v ON_ERROR_STOP=1 -U app_migrator -d \"$POSTGRES_DB\" -f /opt/bad-crm/sql/01-grants.sql'",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:seed:permissions": "turbo run db:seed:permissions",
    "db:audit-partitions": "turbo run db:audit-partitions",
    "db:reset": "turbo run db:reset",
    "api:gen": "turbo run api:gen",
    "docker:up": "bash scripts/docker/up.sh",
    "docker:up:minimal": "COMPOSE_PROFILES=minimal bash scripts/docker/up.sh",
    "docker:down": "docker compose --profile '*' down",
    "docker:logs": "docker compose --profile '*' logs -f --tail=100",
    "docker:reset": "bash scripts/docker/reset.sh",
    "prepare": "husky"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "brace-expansion@<1.1.18": ">=1.1.18 <2",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "brace-expansion@>=3.0.0 <5.0.9": ">=5.0.9",
      "fast-uri@<3.1.5": ">=3.1.5 <4",
      "fast-uri@>=4.0.0 <4.1.2": ">=4.1.2",
      "js-yaml@<4.3.0": ">=4.3.0",
      "keyv@>=6.0.0": "<6.0.0",
      "cacheable@>=2.5.1": "<2.5.1",
      "flat-cache@>=6.1.24": "<6.1.24",
      "file-entry-cache@>=11.1.6": "<11.1.6"
    }
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.5",
    "@types/node": "26.1.2",
    "@types/pg": "8.20.3",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/eslint-plugin": "1.6.24",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "65.0.1",
    "globals": "17.8.0",
    "husky": "9.1.7",
    "jsonc-parser": "3.3.1",
    "lint-staged": "17.2.0",
    "pg": "8.22.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
