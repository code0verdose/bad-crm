{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // `DOM` because callbacks handed to `page.evaluate`/`page.waitForFunction` are compiled here and
    // executed in the browser: without it `document` and `Animation` are unknown names, and the way
    // around that is a stringified expression the compiler cannot check at all.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true
  },
  // No `references`: e2e drives the running stack over HTTP and UI, never its sources.
  // `*.ts` covers the package root: `playwright.config.ts` decides how the suite runs and
  // `global-setup.ts` performs I/O. Left out of the include, both were shipped untypechecked.
  "include": ["*.ts", "src/**/*.ts", "tests/**/*.ts"]
}
