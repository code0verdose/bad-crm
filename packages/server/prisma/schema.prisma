// Bad CRM — Prisma schema (STORY-003-06).
//
// SOURCE OF TRUTH: `docs/architecture/data-model.md`. Names, labels [T]/[G] and index names come
// from that document; this file is its executable half. A model added here without a row there is
// a divergence to escalate, not a decision to take (CLAUDE.md, «Порядок источников истины»).
//
// SCOPE OF THIS FILE TODAY: the tenant root, the identity tables of EPIC-006 and one further
// tenant-scoped table. That is deliberate — the full model is M2+ work, and the point of the first
// migrations is to establish the shape every later table is copied from: `organization_id`,
// ENABLE + FORCE row level security, a policy with both USING and WITH CHECK, explicit grants,
// composite foreign keys, and an isolation test with a positive control (invariant 1 of CLAUDE.md,
// `docs/security/rls-design.md`).
//
// WHAT PRISMA CANNOT EXPRESS, AND WHERE IT THEREFORE LIVES:
//   * row level security, policies and grants — written by hand in the migration that creates the
//     table, in the same file, never "in the next one";
//   * partial unique indexes (`WHERE deleted_at IS NULL`), which `docs/architecture/data-model.md`
//     requires on every softly deleted table — also hand-written in the migration.
// Both are invisible to `prisma migrate diff`, so `prisma migrate dev` would report drift and
// offer to reset. Migrations here are authored by hand and applied with `migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime: the `app_user` role, which is subject to RLS and owns nothing.
  url = env("DATABASE_URL")

  // Migrations and introspection: the `app_migrator` role, which owns the schema. `app_user` has
  // no CREATE on schema `public`, so a migration over `url` dies on the very first statement —
  // Prisma creating `_prisma_migrations` (docs/security/rls-design.md, «DATABASE_URL для каждой
  // роли»).
  directUrl = env("DATABASE_MIGRATION_URL")
}

/// Tenant root. Labelled [T]* in the data model: it has no `organization_id` of its own, so its
/// policy compares the primary key instead (docs/security/rls-design.md, «Особый случай:
/// organizations»). Consequence for the application: the id of a new organization is generated by
/// the application and the row is created inside `withTenant` with that same id.
model Organization {
  id   String @id(map: "pk_organizations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Globally unique, and safe as such: it is chosen by the installation owner, not by a tenant
  /// guessing at other tenants (docs/security/rls-design.md, residual risk 7).
  slug String @unique(map: "uq_organizations_slug")
  name String

  timezone        String @default("UTC")
  defaultCurrency String @default("USD") @map("default_currency") @db.Char(3)
  settings        Json   @default("{}")

  /// The account that administers this organization, set by the registration use-case of
  /// STORY-006-01 immediately after it creates the owner.
  ///
  /// Mandatory since the contract step (`20260730120000_organization_owner_not_null`): an
  /// organization whose owner is nobody is an organization nobody can administer, and that is now a
  /// statement the database makes rather than one the registration transaction keeps.
  ///
  /// It was nullable through the expand step, because the row it points at was written a statement
  /// later. That is no longer true: `OrganizationRepositoryPort.createWithOwner` writes both rows in
  /// **one** statement, with both ids generated before it runs, so the reference is satisfiable at the
  /// moment of the insert without deferring anything (docs/architecture/data-model.md, «Про
  /// `Organization.ownerId`»).
  ///
  /// The composite foreign key is `(id, owner_id) -> users (organization_id, id)`: this table is the
  /// tenant root, so its *own key* is the tenant column, and pairing it with the reference is what
  /// stops an owner from another organization — foreign key checks bypass row-level security.
  ///
  /// Both actions are `NoAction`, and deliberately. `SetNull` cannot succeed against a NOT NULL
  /// column, so it would only ever raise about a constraint the reader was not looking at; `NoAction`
  /// says the real rule — a user who owns an organization cannot be deleted, transfer first. `onUpdate`
  /// is `NoAction` because the referenced key is an immutable uuid and a cascade would write both
  /// columns of the pair, including the primary key. Do not "fix" either by relaxing it; read the
  /// migration.
  ownerId String @map("owner_id") @db.Uuid

  owner User @relation("OrganizationOwner", fields: [id, ownerId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_organizations_owner_id")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  teams               Team[]
  teamMembers         TeamMember[]
  employeeProfiles    EmployeeProfile[]
  roles               Role[]
  rolePermissions     RolePermission[]
  userRoles           UserRole[]
  permissionOverrides UserPermissionOverride[]
  auditLogs           AuditLog[]
  users               User[]
  invitations         Invitation[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]

  @@map("organizations")
}

/// Membership state of an account, `docs/architecture/data-model.md` §1. No default: a row is
/// created either by registration (`ACTIVE`) or by an invitation (`INVITED`), and a column default
/// would decide that for whichever path forgets to.
enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED

  @@map("user_status")
}

/// Why a session stopped being valid. A closed set defined by code and changed only by a release,
/// which is what `docs/architecture/data-model.md` («Enum в Prisma vs строка/справочник») makes an
/// enum rather than a free string — the database refuses a value nobody reviewed.
///
/// Every value answers an acceptance criterion of EPIC-006, and no value is here "for later":
///   * `ROTATED`          — the refresh was exchanged for a new one (STORY-006-03);
///   * `REUSE_DETECTED`   — an already-spent refresh came back, so the whole family is revoked
///                          (STORY-006-03);
///   * `LOGOUT`           — the owner of the session signed out (STORY-006-04);
///   * `REVOKED_BY_USER`  — revoked from the active-sessions screen (STORY-006-04);
///   * `PASSWORD_CHANGED` — a password change or reset closes every other session
///                          (STORY-006-06, STORY-006-08);
///   * `OFFBOARDING`      — the account stopped being able to hold sessions: suspended, deactivated
///                          or softly deleted (`docs/architecture/data-model.md`, «Про каскады»).
///
/// `OFFBOARDING` and not `USER_DELETED`, which is what this value was called: suspension deletes
/// nothing, and the reason would have been false for the case that produces most of these rows.
/// STORY-012-05 names the value literally, and its one deactivation operation covers both.
enum SessionRevokedReason {
  ROTATED
  REUSE_DETECTED
  LOGOUT
  REVOKED_BY_USER
  PASSWORD_CHANGED
  OFFBOARDING

  @@map("session_revoked_reason")
}

/// Tenant-scoped table [T]: the subject of authentication and authorisation.
///
/// Deliberately *not* the HR record — that is `EmployeeProfile`, and the split is argued in
/// `docs/architecture/data-model.md` §1. This table is read on every authenticated request, so it
/// stays narrow.
///
/// Nothing here is a secret in the clear: `passwordHash` is an argon2id digest, `totpSecretEnc` is
/// AES-256-GCM ciphertext under `APP_ENCRYPTION_KEY`, and the two `authVerifier*` columns belong to
/// the vault's proof-of-knowledge, not to the login path (`docs/security/e2ee-design.md`).
model User {
  id             String @id(map: "pk_users") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// `citext`, so `User@Example.COM` and `user@example.com` are the same address at the level that
  /// decides it — the database. Case folding done in the application is case folding one caller
  /// forgets (STORY-006-01).
  email           String    @db.Citext
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordHash    String    @map("password_hash")

  totpSecretEnc      String?   @map("totp_secret_enc")
  totpEnabledAt      DateTime? @map("totp_enabled_at") @db.Timestamptz(6)
  /// The RFC 6238 time-step of the last TOTP code this account had accepted — the anti-replay
  /// predicate `TotpEnrollmentRepositoryPort.advanceCounter` compares against, never the code itself
  /// (STORY-013-01, acceptance 6). `NULL` until the first code is ever accepted, including the one
  /// that confirms enrolment.
  totpLastCounter    Int?      @map("totp_last_counter")
  /// When a **draft** secret (`totpEnabledAt IS NULL`) stops being confirmable. Set by `setup`, read
  /// by `confirm`'s own predicate, and never swept by a job: nothing currently runs one
  /// (`ADR-0021` is not wired to a queue yet), so an unconfirmed draft simply becomes unusable at
  /// this timestamp rather than disappearing — the next `setup` overwrites it regardless
  /// (STORY-013-01, acceptance 3).
  totpDraftExpiresAt DateTime? @map("totp_draft_expires_at") @db.Timestamptz(6)

  /// Bumped on every change to this user's roles, overrides or ACL entries, carried in the access
  /// token as `pv`; a token whose `pv` is behind the row is stale and the rights are re-read. That
  /// is what makes a permission revocation immediate without storing every issued token.
  permissionsVersion Int @default(1) @map("permissions_version")

  status     UserStatus
  lastSeenAt DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  locale     String     @default("en")
  timezone   String     @default("UTC")

  /// `saltB` (16 bytes) and `argon2id(authVerifier, serverSalt)` of the vault, nullable because the
  /// vault is switched on per user. They never derive from `passwordHash` and never derive it
  /// (`docs/security/e2ee-design.md`, §«Разбор каждого ключа»).
  authVerifierSalt Bytes?  @map("auth_verifier_salt")
  authVerifierHash String? @map("auth_verifier_hash")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "fk_users_organization_id")
  ownedOrganizations  Organization[]           @relation("OrganizationOwner")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  roles               UserRole[]               @relation("UserRoleHolder")
  rolesGranted        UserRole[]               @relation("UserRoleGrantor")
  teamMemberships     TeamMember[]
  employeeProfile     EmployeeProfile?         @relation("EmployeeAccount")
  manages             EmployeeProfile[]        @relation("EmployeeManager")
  permissionOverrides UserPermissionOverride[] @relation("OverrideSubject")
  invitationsSent     Invitation[]             @relation("InvitationAuthor")
  invitationAccepted  Invitation[]             @relation("InvitationAcceptor")
  overridesGranted    UserPermissionOverride[] @relation("OverrideGrantor")

  /// The target every composite foreign key into this table points at. A child referencing
  /// `users (id)` alone would be allowed to name a user of another organization: foreign key checks
  /// run as the table owner and bypass RLS (rules/tenancy-rls.mdc, 7).
  @@unique([organizationId, id], map: "uq_users_org_id")
  /// `uq_users_org_email` is not declared here: it is partial (`WHERE deleted_at IS NULL`), which
  /// Prisma cannot express, so it lives in the migration. E-mail is unique inside an organization
  /// and not globally — the same person may hold accounts in two self-hosted organizations.
  @@index([organizationId, status], map: "idx_users_org_status")
  @@map("users")
}

/// Tenant-scoped table [T]: one refresh-token family member, i.e. one signed-in device.
///
/// The refresh token itself is never stored — `refreshTokenHash` is its SHA-256. Rotation writes a
/// new row carrying the same `familyId` and pointing back at its predecessor, so presenting a
/// spent token is detectable and revokes the whole family in one indexed update
/// (`docs/architecture/data-model.md`, «Про refresh-семейства»).
model Session {
  id             String @id(map: "pk_sessions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  /// The family, as a column rather than a chain to walk: revocation on reuse detection has to be
  /// one indexed `UPDATE`, not a recursive traversal.
  familyId      String  @map("family_id") @db.Uuid
  /// The row this one was rotated from. `SetNull`, because the chain exists to reconstruct an
  /// incident: `Cascade` would let the cleanup job remove one expired ancestor and take every live
  /// descendant of the family with it — every rotation extends `expiresAt`, so the ancestor is
  /// always the first row to expire.
  ///
  /// `prisma validate` warns here that `SetNull` meets a required referenced field, and the warning
  /// is expected rather than ignored: a plain composite `ON DELETE SET NULL` would null
  /// `organization_id` too and die on its NOT NULL. The migration writes the PostgreSQL 15 column
  /// list — `ON DELETE SET NULL (rotated_from_id)` — which nulls only the nullable half. Do not
  /// "fix" this by relaxing the action; fix it by reading the migration.
  rotatedFromId String? @map("rotated_from_id") @db.Uuid

  /// SHA-256 of 32 CSPRNG bytes. Globally unique on purpose — see «Про глобальность
  /// uq_sessions_refresh_hash» in `docs/architecture/data-model.md`: the refresh path resolves a
  /// session by this value alone, before any organization is known.
  refreshTokenHash Bytes  @map("refresh_token_hash")
  userAgent        String @map("user_agent")
  /// A hash, never the address itself: it answers "the same address as that session" and cannot be
  /// read back, which is why it is not what the screen shows.
  ipHash           String @map("ip_hash")
  /// What the screen does show — the address with its host half removed (IPv4 /24, IPv6 /48),
  /// computed at sign-in by `src/domain/identity/mask-ip-address.util.ts`. The full address is
  /// stored nowhere at all; `unknown` when the deployment provided nothing readable, which is what
  /// keeps this column NOT NULL (`docs/architecture/data-model.md`, «Про адрес сессии»).
  ipMasked         String @map("ip_masked")

  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason SessionRevokedReason? @map("revoked_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "fk_sessions_organization_id")
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, map: "fk_sessions_user_id")

  rotatedFrom Session?  @relation("SessionRotation", fields: [organizationId, rotatedFromId], references: [organizationId, id], onDelete: SetNull, map: "fk_sessions_rotated_from_id")
  rotatedInto Session[] @relation("SessionRotation")

  /// The self-reference above needs a composite target of its own: a rotation chain must not be
  /// able to cross into another organization any more than a child table may.
  @@unique([organizationId, id], map: "uq_sessions_org_id")
  @@unique([refreshTokenHash], map: "uq_sessions_refresh_hash")
  @@index([organizationId, userId, familyId], map: "idx_sessions_org_user_family")
  /// Revoking a family on reuse detection knows the digest, not the user, so the statement is
  /// `WHERE family_id = $1` with `organization_id` supplied by the policy. The three-column index
  /// above cannot answer that — `user_id` sits between the two columns given — and `family_id`
  /// becomes a filter over every session of the organization
  /// (`migrations/20260729130000_index_sessions_org_family`).
  @@index([organizationId, familyId], map: "idx_sessions_org_family")
  /// `idx_sessions_org_expires` is partial (`WHERE revoked_at IS NULL`) and lives in the migration.
  @@map("sessions")
}

/// Tenant-scoped table [T]: one outstanding password-reset request.
///
/// A table and not two columns on `User`: a user may ask more than once, each request has its own
/// deadline, and one pair of columns cannot hold that. Only the SHA-256 of the token is stored; the
/// token itself exists in the mail and in the URL and nowhere else. Spending a token is
/// `UPDATE ... WHERE id = $1 AND used_at IS NULL RETURNING id`, so a second click loses the race
/// rather than resetting the password twice (STORY-006-08).
model PasswordResetToken {
  id             String @id(map: "pk_password_reset_tokens") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  /// Globally unique for the same reason as `Session.refreshTokenHash`: the link is opened by
  /// somebody who is not signed in, so the lookup has only this value to go on.
  tokenHash       Bytes     @map("token_hash")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt          DateTime? @map("used_at") @db.Timestamptz(6)
  /// Same hash-not-address rule as `Session.ipHash`; nullable because a request may arrive where
  /// no peer address is available.
  requestedIpHash String?   @map("requested_ip_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "fk_password_reset_tokens_organization_id")
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, map: "fk_password_reset_tokens_user_id")

  @@unique([tokenHash], map: "uq_password_reset_tokens_hash")
  /// Not partial, unlike `idx_password_reset_tokens_org_expires` below it in the migration: this is
  /// also the index the composite foreign key on `users` uses when a user row is removed, and a
  /// partial index cannot serve a cascade.
  ///
  /// Declared here and not only in the migration, which is where it lived and where being alone was
  /// a defect: `prisma migrate diff --to-schema-datamodel` answered `DROP INDEX
  /// "idx_password_reset_tokens_org_user"`, and `prisma migrate dev` generates the next migration
  /// out of exactly that diff. The index would have been dropped by whoever next added a field.
  /// Held by `test/integration/db/schema-drift.test.ts`.
  @@index([organizationId, userId], map: "idx_password_reset_tokens_org_user")
  /// `idx_password_reset_tokens_org_expires` is partial (`WHERE used_at IS NULL`), which Prisma
  /// cannot express, so it stays in the migration — and stays invisible to `migrate diff`, which
  /// models no partial index and therefore neither demands nor drops it.
  @@map("password_reset_tokens")
}

/// Tenant-scoped table [T]: one issued recovery code for one account's 2FA (STORY-013-02).
///
/// **`code_hash` is argon2id, not SHA-256.** Unlike `PasswordResetToken.tokenHash` or
/// `Session.refreshTokenHash` — both 256 bits of CSPRNG output, where a lookup can equality-match the
/// digest directly — a recovery code is ten characters from a 31-symbol alphabet
/// (`RECOVERY_CODE_ENTROPY_BITS` ≈ 49.4 bits), read and typed by a person rather than pasted from a
/// link. Consuming one is therefore a loop over this account's unused rows, verifying each candidate's
/// hash in turn (`RecoveryCodeRepositoryPort`), not a `WHERE code_hash = $1`.
///
/// **No plaintext column, ever.** The batch of ten is returned to the caller exactly once, in the
/// response body of `confirm` or of `regenerate`, and never written to a row — see
/// `mfa-recovery-code-structure.test.ts` for the structural assertion that the column does not exist.
model MfaRecoveryCode {
  id             String @id(map: "pk_mfa_recovery_codes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  codeHash String    @map("code_hash")
  usedAt   DateTime? @map("used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// `onUpdate: NoAction` is written out, and that is the point of writing it: Prisma emits
  /// `ON UPDATE CASCADE` for a relation that declares nothing, which is how this reference shipped
  /// with a cascade nobody chose (`docs/architecture/data-model.md`, «Про `Organization.ownerId`»,
  /// closed 2026-07-30 — the referenced key is an immutable uuid, so a cascade can only ever rewrite
  /// a child the operator did not name).
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_mfa_recovery_codes_organization_id")
  /// Composite, like every reference in this schema: a single-column `FOREIGN KEY (user_id)` would
  /// let a row be inserted naming a user of another organization — foreign key checks run as the
  /// table owner and bypass row-level security (`rules/tenancy-rls.mdc`, rule 7). `Cascade`: a
  /// recovery code without the account it recovers is not a row anybody reads.
  ///
  /// **`NoAction` on update, and here it is the tenant boundary that depends on it.** The referenced
  /// pair is `(organization_id, id)`, so under a cascade an `UPDATE users SET organization_id = …` —
  /// a support fix, a backfill, a future transfer of an account — silently rewrites
  /// `mfa_recovery_codes.organization_id` too and carries the material of a second factor into
  /// another tenant. Foreign key checks run as the table owner and bypass RLS, so neither `USING` nor
  /// `WITH CHECK` is consulted; with `NoAction` the operator is refused instead
  /// (`migrations.test.ts`, «the recovery codes of an account»).
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mfa_recovery_codes_user_id")

  /// The one index besides the primary key, and the only one this table needs.
  ///
  /// It is what `ON DELETE CASCADE` from `users` scans, and it serves the reads: the consume loop
  /// asks for one account's unused rows, `{ total, remaining }` counts that account's rows twice
  /// (once **without** `used_at` in the predicate), and the bulk delete on regeneration removes all
  /// of them, spent ones included. Only one of the three filters on `used_at`.
  ///
  /// A partial `WHERE used_at IS NULL` twin shipped beside it and was removed
  /// (`20260812090000_mfa_recovery_codes_fk_actions`): a batch is ten codes and a regeneration
  /// deletes the whole set, so both indexes pointed at the same ≤10 rows — while `used_at` in the
  /// predicate kept spending a code from ever being a HOT update, and made issuing a batch write
  /// twenty index tuples instead of ten.
  @@index([organizationId, userId], map: "idx_mfa_recovery_codes_org_user")
  @@map("mfa_recovery_codes")
}

/// Tenant-scoped table [T]: an org-structure container — «who works together».
///
/// **Not a group of access** (STORY-012-07, acceptance 10). Nothing is granted by belonging to one:
/// the `ResourceAcl` that would make a team the subject of a grant is STORY-011-06, blocked until a
/// resource layer exists, and separate access groups (`subjectType = GROUP`) are open question 3 of
/// `permission-model.md` §12.
///
/// **There is no `lead_id`, and there will not be one.** `data-model.md` §1 and STORY-012-07 both
/// name a `leadId` here; the lead is `team_members.team_role = 'LEAD'`, constrained by
/// `ck_team_members_role`, and has been since the membership table was created. Two models of one
/// fact drift the first time one of them is written without the other — a column saying Ivan leads
/// the team while no membership row says so, or the reverse, with no way to tell which is right. The
/// membership was kept because it is the one the product already reads. Recorded in the story file
/// under «Расхождение с этой спекой»; `data-model.md` carries the same note.
model Team {
  id             String  @id(map: "pk_teams") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "fk_teams_organization_id")
  members      TeamMember[]

  /// Not decoration: a child table referencing a team must use the composite key
  /// `(organization_id, team_id)`, and a composite foreign key needs this unique constraint to
  /// point at. Foreign key checks run as the table owner and bypass RLS, so a single-column
  /// reference would happily confirm a team of another organization (rules/tenancy-rls.mdc, 7).
  @@unique([organizationId, id], map: "uq_teams_org_id")
  @@index([organizationId, name], map: "idx_teams_org_name")
  /// `uq_teams_org_slug` is not declared here: it is partial (`WHERE deleted_at IS NULL`), which
  /// Prisma cannot express, so it stays in the migration that created the table — and stays
  /// invisible to `migrate diff`, which models no partial index and therefore neither demands nor
  /// drops it. The partial clause is the whole point: it is what makes a slug freed by disbanding a
  /// team reusable, while «unique inside the organization» still holds among live ones.
  @@map("teams")
}

/// Tenant-scoped table [T]: кадровая запись о человеке — отдельно от учётной записи.
///
/// Not every `User` is an employee: a contractor, a client representative with access to one project
/// and an integration bot have no hiring date and no manager, and nullable HR columns on `users`
/// would mean the schema does not say so (`data-model.md`, «Почему `User` и `EmployeeProfile`
/// разделены»).
///
/// **The person's name lives here and nowhere else.** It takes part in no decision about access, and
/// every screen that shows a human reads this table anyway.
model EmployeeProfile {
  id             String @id(map: "pk_employee_profiles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  jobTitle   String? @map("job_title")
  department String?
  managerId  String? @map("manager_id") @db.Uuid

  /// Hours a week this person is planned against. `ck_employee_profiles_capacity` bounds it 0…80 in
  /// the database; the Zod schema answers the person editing the form.
  weeklyCapacityHours Int    @default(40) @map("weekly_capacity_hours")
  /// `FULL_TIME` | `PART_TIME` | `CONTRACTOR` | `INTERN`, constrained by
  /// `ck_employee_profiles_employment_type`. Text rather than a PostgreSQL enum: adding a value to
  /// an enum is DDL on a type every user of it depends on.
  employmentType      String @default("FULL_TIME") @map("employment_type")

  hiredAt      DateTime? @map("hired_at") @db.Date
  /// Set on offboarding: the account is suspended, never deleted — years of time entries, tasks and
  /// audit entries reference this person.
  terminatedAt DateTime? @map("terminated_at") @db.Date

  timezone String   @default("UTC")
  /// Searchable «кто умеет postgres», with a GIN index. A join table the day levels or endorsements
  /// make a skill an entity of its own.
  skills   String[] @default([])

  /// **Ciphertext only**, `v1:<iv>:<tag>:<ciphertext>` under `APP_ENCRYPTION_KEY`. There is no
  /// plaintext column: an emergency contact is somebody else's personal data, and a dump of this
  /// table must not be a list of relatives' phone numbers.
  emergencyContactEnc String? @map("emergency_contact_enc")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_employee_profiles_organization_id")
  user         User         @relation("EmployeeAccount", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_employee_profiles_user_id")
  /// `Restrict`: an account that still manages somebody is not deleted quietly — reassign first.
  manager      User?        @relation("EmployeeManager", fields: [organizationId, managerId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_employee_profiles_manager_id")

  @@unique([organizationId, userId], map: "uq_employee_profiles_user")
  @@index([organizationId, managerId], map: "idx_employee_profiles_org_manager")
  /// «Кто умеет postgres»: the predicate is `skills && ARRAY[…]`, which is a GIN question rather
  /// than a B-tree one. Declared here rather than only in the migration because Prisma **can**
  /// express it, and an index it can express but does not see is one `prisma migrate dev` offers to
  /// drop — which `test/integration/db/schema-drift.test.ts` catches on the spot.
  @@index([skills(ops: ArrayOps)], map: "idx_employee_profiles_skills", type: Gin)
  /// `idx_employee_profiles_org_active` is not declared here: it is partial
  /// (`WHERE terminated_at IS NULL`), which Prisma's datamodel cannot express. It lives in the
  /// migration, like `uq_users_org_email`.
  @@map("employee_profiles")
}

/// Tenant-scoped table [T]: «этот человек в этой команде».
///
/// The row an invitation's `team_ids` draft turns into on acceptance. A table rather than an array
/// on either side, because everything downstream asks questions of it — кто в команде, чья это
/// доска, кому идёт уведомление — and an array answers none of them with an index.
model TeamMember {
  id             String @id(map: "pk_team_members") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  teamId         String @map("team_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  /// `MEMBER` | `LEAD`, constrained by `ck_team_members_role` in the migration. Text rather than a
  /// PostgreSQL enum: adding a value to an enum is DDL on a type every user of it depends on.
  teamRole       String @default("MEMBER") @map("team_role")

  joinedAt  DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_team_members_organization_id")
  team         Team         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_team_members_team_id")
  user         User         @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_team_members_user_id")

  /// Joining a team twice is the same membership, not a second one — which is what makes acceptance
  /// idempotent without the use-case reading first.
  @@unique([teamId, userId], map: "uq_team_members")
  @@index([organizationId, userId], map: "idx_team_members_org_user")
  @@map("team_members")
}

/// Tenant-scoped table [T]: an invitation to join this organization.
///
/// **A role assignment written in advance**, which is why it carries a role and why the policy that
/// creates one applies the same subset rule as an assignment (`T-IAM-09`).
///
/// The token lives only in the link that was handed out. What is stored is `token_hash` — SHA-256 of
/// 32 CSPRNG bytes — for the same reason sessions store one: a dump, a backup or a curious operator
/// must not yield a working invitation. `uq_invitations_token` is therefore on the **hash**, and it
/// is one of the few unique keys declared globally: a digest collision across organizations would be
/// a collision of the credential itself.
model Invitation {
  id             String @id(map: "pk_invitations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  email   String
  /// The role the account will hold once it exists. Optional: «somebody who can sign in and nothing
  /// else» is a legitimate invitation.
  roleId  String?  @map("role_id") @db.Uuid
  /// Teams the account joins on acceptance. An array rather than a join table because it is a
  /// **draft** — nothing references it until the invitation is accepted, and then it becomes rows in
  /// `team_members` and stops being read.
  teamIds String[] @default([]) @map("team_ids") @db.Uuid

  tokenHash      Bytes     @map("token_hash")
  /// Which language the letter is written in. The recipient has no account, so there is no
  /// `users.locale` to read; the inviter's own language is the best available guess, and it is
  /// stored rather than passed so that a resend produces the same letter as the first one.
  /// Constrained to `en` and `ru` by `ck_invitations_locale` in the migration.
  locale         String    @default("en")
  invitedById    String    @map("invited_by_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  /// `null` while it is still an invitation; a date once it became a person.
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(6)
  acceptedUserId String?   @map("accepted_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invitations_organization_id")
  /// `Restrict`, not `SetNull`: the composite key carries `organization_id`, which is not nullable,
  /// and a role that still has open invitations is a role somebody is about to hold — deleting it
  /// out from under them is the change that should stop, not the invitation.
  role         Role?        @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invitations_role_id")
  invitedBy    User         @relation("InvitationAuthor", fields: [organizationId, invitedById], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invitations_invited_by_id")
  /// Same reason as the role above; and an accepted invitation is history, so the person it names
  /// should not be deletable without deciding what happens to that history first.
  acceptedUser User?        @relation("InvitationAcceptor", fields: [organizationId, acceptedUserId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_invitations_accepted_user_id")

  /// The credential, and the only global unique key of this table — see the note above.
  @@unique([tokenHash], map: "uq_invitations_token")
  /// `idx_invitations_org_email` is not declared here: it is partial and unique
  /// (`WHERE accepted_at IS NULL`), which Prisma's datamodel cannot express, so it lives in the
  /// migration — exactly like `uq_users_org_email`. One **open** invitation per address per
  /// organization; a closed one is history, and inviting somebody again after they left is an
  /// ordinary thing to do.
  @@map("invitations")
}

/// Global reference table [G]: the catalogue of permission keys, seeded from code.
///
/// The one table in this schema without `organizationId`, and deliberately so
/// (`docs/architecture/data-model.md`, group 2): the catalogue is defined by the **code** — the key
/// `vault_item:decrypt` exists because a use-case checks it — so a tenant cannot invent a permission
/// and has nothing to hang one on. It is therefore readable by every organization and written only
/// by the seed.
///
/// References point at `key`, not at a uuid: a human-readable identifier survives a rebuild of the
/// catalogue and keeps dumps readable.
model Permission {
  key      String @id(map: "pk_permissions")
  resource String
  action   String
  /// The bounded context the key belongs to (`PERMISSION_META.domain` in `@bad-crm/shared`).
  category String

  isDangerous Boolean @default(false) @map("is_dangerous")

  /// A key removed from the code is **marked**, never deleted: rows in `RolePermission` and
  /// `UserPermissionOverride` point here, and dropping the row would break every installation where
  /// an administrator had already granted it. A deprecated key is not offered in the UI and always
  /// resolves to «no permission» in the policy layer (`docs/architecture/data-model.md`, group 2).
  deprecatedAt DateTime? @map("deprecated_at") @db.Timestamptz(6)

  createdAt  DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  roleGrants RolePermission[]
  overrides  UserPermissionOverride[]

  @@index([resource, action], map: "idx_permissions_resource")
  /// `idx_permissions_active` is not declared here: it is partial (`WHERE deprecated_at IS NULL`,
  /// because the role-matrix screen lists only the live catalogue), which Prisma cannot express — so
  /// it lives in the migration, exactly like `uq_users_org_email`.
  @@map("permissions")
}

/// Tenant-scoped table [T]: a role of one organization (layer 2 of the permission model).
///
/// A role is a **starting point**, not a straitjacket: what one person needs beyond it is expressed
/// by a per-user override or a resource ACL, never by inventing a fortieth role
/// (`docs/security/permission-model.md`, «Слой 2 — роли»).
model Role {
  id             String @id(map: "pk_roles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// `owner` | `admin` | … for system roles; chosen by the organization for its own.
  key         String
  name        String
  description String?

  /// System roles are code: their composition comes from `SYSTEM_ROLE_PERMISSIONS` and is
  /// re-applied on upgrade, and the interface refuses to edit or delete one.
  isSystem  Boolean @default(false) @map("is_system")
  /// The role a new member gets when nobody chooses one; at most one per organization.
  isDefault Boolean @default(false) @map("is_default")
  priority  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_roles_organization_id")
  permissions  RolePermission[]
  holders      UserRole[]
  invitations  Invitation[]

  /// The target every composite foreign key into this table points at: a child referencing `id`
  /// alone could name a role of another organization, because foreign key checks bypass RLS.
  @@unique([organizationId, id], map: "uq_roles_org_id")
  @@unique([organizationId, key], map: "uq_roles_org_key")
  /// `idx_roles_org_default` is not declared here: it is partial (`WHERE is_default`), which Prisma
  /// cannot express, so it lives in the migration.
  @@map("roles")
}

/// Tenant-scoped table [T]: one permission granted by one role. **ALLOW only** — a role that could
/// deny would make «which role wins» unanswerable the moment a person holds two of them.
model RolePermission {
  id             String @id(map: "pk_role_permissions") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid
  /// References `Permission.key`: a name, not a uuid, so the row survives a rebuilt catalogue.
  permissionKey  String @map("permission_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_role_permissions_role_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_role_permissions_organization_id")
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: NoAction, onUpdate: NoAction, map: "fk_role_permissions_permission_key")

  @@unique([roleId, permissionKey], map: "uq_role_permissions")
  @@index([organizationId, roleId], map: "idx_role_permissions_org_role")
  @@map("role_permissions")
}

/// How an action reached the system, for the entry in the trail.
enum AuditActorType {
  USER
  SYSTEM
  API_KEY
  INTEGRATION
}

/// How loudly an entry should read. `CRITICAL` is what a review starts from — ownership transfer,
/// impersonation, escrow, export of the trail itself (`docs/security/permission-model.md` §10).
enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

/// Tenant-scoped table [T]: the audit trail. **Append-only, and partitioned by month.**
///
/// Two things about this model are not visible in it, and both are deliberate:
///
///   * **The application holds no `UPDATE` or `DELETE` privilege on the table.** Prisma will happily
///     generate `auditLog.update`; the database answers `permission denied`. That is the point — a
///     journal the code can rewrite records what the code chose to admit
///     (`prisma/sql/01-grants.sql`, and `docs/architecture/data-model.md`, «Про `AuditLog` как
///     append-only»).
///   * **`PARTITION BY RANGE (occurred_at)` cannot be declared here.** Prisma has no syntax for it,
///     so the table is created by hand in `20260805110000_audit_logs`, and this model describes the
///     result. The composite id below is the visible half of that: a partitioned table's primary key
///     has to contain the partition key.
model AuditLog {
  id             String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  /// No relation to `User` on purpose: `SYSTEM` events have no actor, and an entry has to outlive
  /// the account it names — a trail that loses its actor answers «somebody» to the one question it
  /// exists for.
  actorId   String?        @map("actor_id") @db.Uuid
  actorType AuditActorType @map("actor_type")

  /// `role.assigned`, `audit.exported` — the vocabulary of §10 of the permission model. Text rather
  /// than an enum: every domain adds actions, and an enum value cannot be removed.
  action       String
  resourceType String  @map("resource_type")
  resourceId   String? @map("resource_id") @db.Uuid

  /// Whitelisted fields, never a whole row: what goes here is shown to whoever may read the trail.
  before Json?
  after  Json?

  /// The address itself is never stored — the hash answers «the same one again» without keeping it.
  ipHash    String? @map("ip_hash")
  userAgent String? @map("user_agent")
  requestId String  @map("request_id")

  severity   AuditSeverity @default(INFO)
  occurredAt DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_audit_logs_organization_id")

  @@id([id, occurredAt], map: "pk_audit_logs")
  @@index([organizationId, occurredAt(sort: Desc)], map: "idx_audit_logs_org_occurred")
  @@index([organizationId, resourceType, resourceId, occurredAt(sort: Desc)], map: "idx_audit_logs_resource")
  @@index([organizationId, actorId, occurredAt(sort: Desc)], map: "idx_audit_logs_actor")
  @@map("audit_logs")
}

/// Tenant-scoped table [T]: one person holding one role, possibly until a date.
///
/// A join table with a surrogate key, like `RolePermission` and for the same reason: the isolation
/// proofs are generated from the registry and address a row by `id`, so a join table without one is
/// a tenant table nothing proves anything about.
///
/// **`expiresAt` is enforced where permissions are assembled**, not only by the cleanup job: the
/// query that builds an actor filters `expiresAt IS NULL OR expiresAt > now()`, so a job that has
/// not run yet cannot mean an expired role that still works.
model UserRole {
  id             String @id(map: "pk_user_roles") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  roleId         String @map("role_id") @db.Uuid

  /// Who granted it. `null` where there was no actor — the owner's role comes from registration
  /// itself — and on the day the grantor's account is deleted, because the record of the assignment
  /// must outlive the person who made it.
  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation("UserRoleHolder", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_user_id")
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_roles_role_id")
  grantedBy    User?        @relation("UserRoleGrantor", fields: [organizationId, grantedById], references: [organizationId, id], onDelete: SetNull, onUpdate: NoAction, map: "fk_user_roles_granted_by_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_user_roles_organization_id")

  /// Assigning a role twice is the same assignment: the uniqueness is what makes the operation
  /// idempotent without the use-case reading first.
  @@unique([userId, roleId], map: "uq_user_roles")
  @@index([organizationId, userId], map: "idx_user_roles_org_user")
  /// The other direction: «who holds this role». Neither index above leads with `role_id`, so the
  /// holder count of every role on the administration matrix, the invalidation of everybody holding
  /// a role that changed, and the cascade of deleting one all scanned the assignments of the whole
  /// organization (STORY-011-03).
  @@index([organizationId, roleId], map: "idx_user_roles_org_role")
  @@map("user_roles")
}

/// Which way an exception points. **ALLOW only exists at this layer**: a role that could deny would
/// make «which role wins» unanswerable the moment somebody holds two of them.
enum OverrideEffect {
  ALLOW
  DENY
}

/// Tenant-scoped table [T]: one exception, for one person, on one permission (layer 3).
///
/// What this layer is for: «custom per user» without inventing a role for every difference. The
/// failure it prevents is an organization with forty roles named `manager_without_finance_2`, none
/// of which anybody can define.
///
/// Three rules are in the schema and not in an agreement: one opinion per key
/// (`uq_user_permission_overrides`), a reason of at least ten characters after trimming
/// (`ck_user_permission_overrides_reason`), and no DENY on the owner (`ck_upo_not_owner`, a trigger,
/// so a direct SQL session cannot write one either).
model UserPermissionOverride {
  id             String @id(map: "pk_user_permission_overrides") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  /// References `Permission.key`: a name, not a uuid, so the row survives a rebuilt catalogue.
  permissionKey  String @map("permission_key")

  effect OverrideEffect
  /// Why. Mandatory, and checked for length by the database: without it nobody remembers six months
  /// later why a right was taken away, and every override becomes permanent.
  reason String

  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  /// Strongly recommended for ALLOW (a temporary widening), optional for DENY. Enforced where the
  /// permissions are assembled, not only by the cleaner.
  expiresAt   DateTime? @map("expires_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User         @relation("OverrideSubject", fields: [organizationId, userId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_upo_user_id")
  grantedBy    User?        @relation("OverrideGrantor", fields: [organizationId, grantedById], references: [organizationId, id], onDelete: SetNull, onUpdate: NoAction, map: "fk_upo_granted_by_id")
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "fk_upo_organization_id")
  permission   Permission   @relation(fields: [permissionKey], references: [key], onDelete: NoAction, onUpdate: NoAction, map: "fk_upo_permission_key")

  /// Also serves «every exception of this person»: `userId` leads it, so a second index on the same
  /// leading column would cost every write and answer nothing new.
  @@unique([userId, permissionKey], map: "uq_user_permission_overrides")
  /// `idx_upo_expires` is not declared here: it is partial (`WHERE expires_at IS NOT NULL`), which
  /// Prisma cannot express, so it lives in the migration.
  @@map("user_permission_overrides")
}
