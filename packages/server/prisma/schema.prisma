// Bad CRM — Prisma schema (STORY-003-06).
//
// SOURCE OF TRUTH: `docs/architecture/data-model.md`. Names, labels [T]/[G] and index names come
// from that document; this file is its executable half. A model added here without a row there is
// a divergence to escalate, not a decision to take (CLAUDE.md, «Порядок источников истины»).
//
// SCOPE OF THIS FILE TODAY: the tenant root and one tenant-scoped table. That is deliberate — the
// full model is M2+ work, and the point of the first migration is to establish the shape every
// later table is copied from: `organization_id`, ENABLE + FORCE row level security, a policy with
// both USING and WITH CHECK, explicit grants, and an isolation test with a positive control
// (invariant 1 of CLAUDE.md, `docs/security/rls-design.md`).
//
// WHAT PRISMA CANNOT EXPRESS, AND WHERE IT THEREFORE LIVES:
//   * row level security, policies and grants — written by hand in the migration that creates the
//     table, in the same file, never "in the next one";
//   * partial unique indexes (`WHERE deleted_at IS NULL`), which `docs/architecture/data-model.md`
//     requires on every softly deleted table — also hand-written in the migration.
// Both are invisible to `prisma migrate diff`, so `prisma migrate dev` would report drift and
// offer to reset. Migrations here are authored by hand and applied with `migrate deploy`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime: the `app_user` role, which is subject to RLS and owns nothing.
  url = env("DATABASE_URL")

  // Migrations and introspection: the `app_migrator` role, which owns the schema. `app_user` has
  // no CREATE on schema `public`, so a migration over `url` dies on the very first statement —
  // Prisma creating `_prisma_migrations` (docs/security/rls-design.md, «DATABASE_URL для каждой
  // роли»).
  directUrl = env("DATABASE_MIGRATION_URL")
}

/// Tenant root. Labelled [T]* in the data model: it has no `organization_id` of its own, so its
/// policy compares the primary key instead (docs/security/rls-design.md, «Особый случай:
/// organizations»). Consequence for the application: the id of a new organization is generated by
/// the application and the row is created inside `withTenant` with that same id.
model Organization {
  id   String @id(map: "pk_organizations") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Globally unique, and safe as such: it is chosen by the installation owner, not by a tenant
  /// guessing at other tenants (docs/security/rls-design.md, residual risk 7).
  slug String @unique(map: "uq_organizations_slug")
  name String

  timezone        String @default("UTC")
  defaultCurrency String @default("USD") @map("default_currency") @db.Char(3)
  settings        Json   @default("{}")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  teams Team[]

  @@map("organizations")
}

/// Tenant-scoped table [T]. `Organization.ownerId` and `Team.leadId` of the data model are absent
/// on purpose: both are foreign keys to `users`, a table this migration does not create. They
/// arrive with the users table in EPIC-006, as an expand step (nullable column, then backfill).
model Team {
  id             String  @id(map: "pk_teams") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  name           String
  slug           String
  description    String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "fk_teams_organization_id")

  /// Not decoration: a child table referencing a team must use the composite key
  /// `(organization_id, team_id)`, and a composite foreign key needs this unique constraint to
  /// point at. Foreign key checks run as the table owner and bypass RLS, so a single-column
  /// reference would happily confirm a team of another organization (rules/tenancy-rls.mdc, 7).
  @@unique([organizationId, id], map: "uq_teams_org_id")
  @@index([organizationId, name], map: "idx_teams_org_name")
  @@map("teams")
}
